{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScaffoldComponent",
  "type": "object",
  "required": [
    "id",
    "name",
    "category",
    "purpose",
    "consumes",
    "produces",
    "configurable",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^H[0-9]{2}$"
    },
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "consumes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "produces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "configurable": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}