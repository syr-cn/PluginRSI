{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExperienceType",
  "type": "object",
  "required": [
    "id",
    "name",
    "category",
    "purpose",
    "required_fields",
    "retention",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^E[0-9]{2}$"
    },
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "required_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "retention": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}