{
  "type": "function",
  "name": "text_search",
  "description": "Search text or regex within a bounded path set. Guards: Bound paths and result count. Return path, line and context.",
  "parameters": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string"
      },
      "paths": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "regex": {
        "type": "boolean"
      },
      "max_results": {
        "type": "integer",
        "minimum": 1
      }
    },
    "required": [
      "query",
      "paths",
      "max_results"
    ],
    "additionalProperties": false
  }
}
